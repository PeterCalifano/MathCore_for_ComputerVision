# Stage authoritative version metadata inside CPack's private package root.

set(_mathcore_package_version_file [==[@PROJECT_BINARY_DIR@/VERSION]==])
if(NOT EXISTS "${_mathcore_package_version_file}")
  message(
    FATAL_ERROR
    "Generated package VERSION is missing: ${_mathcore_package_version_file}")
endif()

file(
  COPY "${_mathcore_package_version_file}"
  DESTINATION "${CMAKE_INSTALL_PREFIX}")
